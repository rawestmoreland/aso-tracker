# Copy to backend/.env for local development (it is git-ignored).
# Real environment variables override anything in this file.

# Weekly report (the cron is only scheduled when the key is set)
ANTHROPIC_API_KEY=
ASO_REPORT_TO=you@example.com
# ASO_REPORT_CRON=0 14 * * 1        # UTC; "off" disables the weekly email
# ASO_REPORT_MODEL=claude-opus-5-5
# Public origin of this server, used for each report's "view in browser" link.
# Falls back to the Application URL in the PocketBase dashboard settings.
# ASO_PUBLIC_URL=https://aso-api.example.com
# Origin of the web app. When set, emails link to <it>/reports/<slug>, the native
# report page. Without it they link to the backend's server-rendered copy.
# ASO_FRONTEND_URL=https://aso.example.com

# Rank check
# ASO_CRON=0 2 * * *                # UTC
# ASO_INTERVAL=3s
# ASO_WORKERS=3
