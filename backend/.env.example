# Copy to backend/.env for local development (it is git-ignored).
# Real environment variables override anything in this file.

# Weekly report (the cron is only scheduled when the key is set)
ANTHROPIC_API_KEY=
ASO_REPORT_TO=you@example.com
# ASO_REPORT_CRON=0 14 * * 1        # UTC; "off" disables the weekly email
# ASO_REPORT_MODEL=claude-opus-5-5

# Rank check
# ASO_CRON=0 2 * * *                # UTC
# ASO_INTERVAL=3s
# ASO_WORKERS=3
